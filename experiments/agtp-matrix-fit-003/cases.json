            "delegate": "agtp:sha256:agent-c",
            "signed_by_key": "ed25519:agent-b-key",
            "scope": [
              "documents:query",
              "mail:send"
            ],
            "minted_at": 1793390350,
            "expires_at": 1793390900
          }
        ]
      },
      "expected_mapping_result": "EXACT",
      "expected_row_outcome": "unsatisfied",
      "expected_agtp_status": 551,
      "expected_agtp_evaluation": "refused",
      "expected_agtp_reason": "scope-exceeds-parent",
      "expected_failing_hop": 1,
      "expected_permitted_conclusion": "Hop 1 names mail:send, which its parent hop never held, so the chain is invalid and the request is refused.",
      "prohibited_conclusions": [
        "A hop signed by a valid parent key may widen scope.",
        "Membership of mail:send in the origin grant repairs a widened later hop."
