{
  "experiment": "AGTP-MATRIX-FIT-003",
  "status": "new-round-pre-adapter-mapping-review",
  "frozen_at": "2026-10-30",
  "outcome_semantics": "expected_row_outcome is a constrained harness prediction and falls short of a complete Principal Binding row-result object. expected_agtp_status and expected_agtp_reason record the -10 wire result the modelled verifier returns.",
  "positive_control": {
    "id": "valid_adjacent_agtp_checks",
    "requirement": "Every hostile case preserves the stated adjacent AGTP signature, identity, scope, token, or attribution checks so the result cannot be explained by a forged container.",
    "expected": "The harness reports only the claim-specific result and never promotes an adjacent success into another row's conclusion."
  },
  "cases": [
    {
      "id": "wrong_presenter",
      "vector_type": "signed-presenter-substitution",
      "title": "Wrong Presenter",
      "matrix_row": "live-presenter",
      "situation": {
        "transport_server_authenticated": true,
        "identity_document_signature_valid": true,
        "registrar_trust_configured": true,
        "agent_id_header_matches_document": true,
        "document_agent_id": "agtp:sha256:agent-a",
        "document_agent_public_key": "ed25519:agent-a-key",
        "live_presenter": "attacker-b",
        "verification_time": 1793390400,
        "acceptance_window_seconds": 300,
        "request_signature": {
          "alg": "EdDSA",
          "kid": "agtp:sha256:agent-a",
          "signing_key": "ed25519:attacker-b-key",
          "covered_fields": [
            "m",
            "p",
            "aid",
            "as",
            "dc",
            "bd",
            "iat",
            "n"
          ],
          "iat": 1793390390,
          "nonce_seen_in_window": false
        },
        "document_re_resolved_before_reject": true
      },
      "expected_mapping_result": "EXACT",
      "expected_row_outcome": "unsatisfied",
      "expected_agtp_status": 401,
      "expected_agtp_reason": "possession-unproven",
      "expected_permitted_conclusion": "The request was refused because its signature does not verify under the agent_public_key the trusted document names for agtp:sha256:agent-a.",
      "prohibited_conclusions": [
        "The live presenter is authenticated as agtp:sha256:agent-a.",
        "A fresh, well-formed Request-Signature proves possession whatever key produced it."
      ],
      "source_refs": [
        "agtp-10:sections-6.5.4,12.2,12.4.1",
        "identity-document-00:sections-3.3"
      ]
    },
